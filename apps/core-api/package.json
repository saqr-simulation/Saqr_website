{
  "name": "@saqr/core-api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "node --watch --require ts-node/register src/main.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "prisma generate && tsc --noEmit && tsc -p tsconfig.tooling.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:verify": "tsx prisma/verify.ts",
    "test": "tsx --test src/auth/auth.guard.test.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@prisma/client": "^6.19.0",
    "@supabase/supabase-js": "^2.99.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "dotenv": "^16.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "zod": "^4.0.0",
    "@saqr/types": "workspace:*"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "prisma": "^6.19.0",
    "tsx": "^4.20.0",
    "ts-node": "^10.9.2"
  }
}
